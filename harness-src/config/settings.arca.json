{
  "permissions": {
    "deny": [
      "Edit(~/Desktop/AIR/Carreer/Projects/ARCA/harness-claude/**)",
      "Write(~/Desktop/AIR/Carreer/Projects/ARCA/harness-claude/**)",
      "Edit(~/Desktop/AIR/Carreer/Projects/ARCA/harness-codex/**)",
      "Write(~/Desktop/AIR/Carreer/Projects/ARCA/harness-codex/**)",
      "Edit(~/Desktop/AIR/Carreer/Projects/ARCA/harness-kimi/**)",
      "Write(~/Desktop/AIR/Carreer/Projects/ARCA/harness-kimi/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$HOME/.claude-product-design/hooks/prompt_injection_check.sh", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/.claude-product-design/hooks/panel-summary.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
