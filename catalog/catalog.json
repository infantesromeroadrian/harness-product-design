{
  "$schema": "../schemas/catalog.schema.json",
  "schema_version": 1,
  "runtime": "claude-code-product-design",
  "components": [
    {
      "capability_id": "guidance.claude-md",
      "description": "Identidad autocontenida del harness (capa de especialista); sin dependencias de una instalacion ARCA",
      "profile": "core",
      "source": "harness-src/guidance/CLAUDE.core.md",
      "destination": {
        "surface": "guidance",
        "mode": "projection",
        "path": "~/.claude-product-design/CLAUDE.md"
      },
      "activation": "active"
    },
    {
      "capability_id": "guidance.claude-md-arca",
      "description": "Variante ARCA: CLAUDE.arca.md (import del nucleo + runtime) seguido de la capa core",
      "profile": "arca",
      "replaces": "guidance.claude-md",
      "source": "harness-src/guidance/CLAUDE.arca.md",
      "append_sources": [
        "harness-src/guidance/CLAUDE.core.md"
      ],
      "destination": {
        "surface": "guidance",
        "mode": "projection",
        "path": "~/.claude-product-design/CLAUDE.md"
      },
      "activation": "active"
    },
    {
      "capability_id": "bin.claude-design",
      "description": "Comando que arranca Claude Code con el directorio de configuracion propio",
      "profile": "core",
      "source": "harness-src/bin/claude-design",
      "destination": {
        "surface": "bin",
        "mode": "projection",
        "path": "~/.local/bin/claude-design",
        "file_mode": "0755"
      },
      "activation": "active"
    },
    {
      "capability_id": "hooks.guard-protected-paths",
      "description": "Bloquea escrituras via Bash en rutas protegidas",
      "profile": "core",
      "source": "harness-src/hooks/guard-protected-paths.sh",
      "destination": {
        "surface": "hooks",
        "mode": "projection",
        "path": "~/.claude-product-design/hooks/guard-protected-paths.sh",
        "file_mode": "0755"
      },
      "activation": "active"
    },
    {
      "capability_id": "hooks.lib-json",
      "description": "Utilidad compartida por los hooks (lectura de tool_input)",
      "profile": "core",
      "source": "harness-src/hooks/lib-json.sh",
      "destination": {
        "surface": "hooks",
        "mode": "projection",
        "path": "~/.claude-product-design/hooks/lib-json.sh",
        "file_mode": "0755"
      },
      "activation": "active"
    },
    {
      "capability_id": "hooks.block-dangerous",
      "description": "Bloquea comandos destructivos (version portable)",
      "profile": "core",
      "source": "harness-src/hooks/block-dangerous.sh",
      "destination": {
        "surface": "hooks",
        "mode": "projection",
        "path": "~/.claude-product-design/hooks/block-dangerous.sh",
        "file_mode": "0755"
      },
      "activation": "active"
    },
    {
      "capability_id": "hooks.detect-secrets",
      "description": "Bloquea secretos en el contenido escrito (version portable)",
      "profile": "core",
      "source": "harness-src/hooks/detect-secrets.sh",
      "destination": {
        "surface": "hooks",
        "mode": "projection",
        "path": "~/.claude-product-design/hooks/detect-secrets.sh",
        "file_mode": "0755"
      },
      "activation": "active"
    },
    {
      "capability_id": "config.settings",
      "profile": "core",
      "source": "harness-src/config/settings.core.json",
      "destination": {
        "surface": "config",
        "mode": "merge",
        "path": "~/.claude-product-design/settings.json",
        "owned_keys": [
          "env.CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS",
          "permissions.deny",
          "hooks",
          "skipDangerousModePermissionPrompt",
          "permissions.defaultMode",
          "permissions.allow"
        ]
      },
      "activation": "active",
      "description": "Base portable: subagentes, deny de rutas protegidas, hooks de seguridad"
    },
    {
      "capability_id": "config.settings-arca",
      "description": "Capa ARCA: deny de los harness hermanos y hooks de ARCA (extiende la base)",
      "profile": "arca",
      "source": "harness-src/config/settings.arca.json",
      "destination": {
        "surface": "config",
        "mode": "merge",
        "path": "~/.claude-product-design/settings.json",
        "owned_keys": [
          "permissions.deny",
          "hooks",
          "env.DESIGN_PROTECTED_PATHS"
        ],
        "strategy": "extend",
        "protected_paths_key": "env.DESIGN_PROTECTED_PATHS"
      },
      "activation": "active"
    },
    {
      "capability_id": "mcp.bundle",
      "profile": "core",
      "source": "harness-src/mcp/mcp.core.json",
      "destination": {
        "surface": "mcp",
        "mode": "merge",
        "path": "~/.claude-product-design/.claude.json",
        "owned_keys": [
          "mcpServers.obsidian",
          "mcpServers.playwright",
          "mcpServers.context7",
          "mcpServers.figma"
        ]
      },
      "activation": "active",
      "description": "MCP portables; obsidian y context7 solo si sus variables de entorno estan definidas al instalar"
    },
    {
      "capability_id": "mcp.arca",
      "description": "Capa ARCA: obsidian sobre el vault local y engram",
      "profile": "arca",
      "source": "harness-src/mcp/mcp.arca.json",
      "destination": {
        "surface": "mcp",
        "mode": "merge",
        "path": "~/.claude-product-design/.claude.json",
        "owned_keys": [
          "mcpServers.obsidian",
          "mcpServers.engram"
        ],
        "strategy": "replace"
      },
      "activation": "active"
    },
